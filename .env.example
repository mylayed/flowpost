# ---- Telegram -----------------------------------------------------------------
# Token from @BotFather
BOT_TOKEN=
# Your Telegram user id(s) for /stats, /grant, /expire, /refund (comma-separated)
ADMIN_IDS=
# Shown in /paysupport, e.g. @your_support
SUPPORT_CONTACT=
# Premium (custom) emoji in posts. Telegram accepts them only from bots that bought a username on
# Fragment (fragment.com) — the admin having Telegram Premium is not enough. While this is false,
# premium emoji are published as the plain emoji they fall back to.
PREMIUM_EMOJI=false

# ---- Storage ------------------------------------------------------------------
# Local dev default is SQLite. Production (Railway): postgresql://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./flowpost.db
# Optional; without it FSM state lives in memory (lost on restart)
REDIS_URL=

# ---- Localization -------------------------------------------------------------
DEFAULT_LANG=uk
DEFAULT_TZ=Europe/Kyiv

# ---- Webhook (production) -----------------------------------------------------
# Public HTTPS base URL, e.g. https://flowpost.up.railway.app — empty = long polling
WEBHOOK_BASE_URL=
WEBHOOK_SECRET=change-me-random-string
# Railway sets PORT automatically
PORT=8080

# ---- AI (Anthropic) -----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
AI_EFFORT=medium
AI_FALLBACKS=true
AI_DAILY_LIMIT_TRIAL=20
AI_DAILY_LIMIT_PAID=150

# ---- Billing ------------------------------------------------------------------
TRIAL_DAYS=30
# LiqPay only processes renewals/cancellations of subscriptions bought before the Stars Mini App
LIQPAY_ENABLED=true
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
LIQPAY_SANDBOX=true

# ---- Billing Mini App (Telegram Stars wallet) ---------------------------------
WEBAPP_ENABLED=true
# Defaults to WEBHOOK_BASE_URL + /app/. For local dev use an HTTPS tunnel, e.g. https://xxxx.trycloudflare.com/app/
WEBAPP_URL=
STARS_TOPUP_MIN=1
STARS_TOPUP_MAX=25000
# Used only to show the "≈ $" hint next to Stars amounts
STARS_USD_RATE=0.02
# Percent of every top-up credited to the cashback balance
CASHBACK_PERCENT=5
# Channels whose subscription ends within this many days are shown under "Time to renew"
RENEW_SOON_DAYS=7
# Extra per-channel packs sold on the "Project limits" screen: kind -> {pack size: price in Stars}
# LIMIT_PRICES='{"wm_photo": {"10": 5, "100": 15, "500": 49, "1000": 75}, "wm_video": {"10": 10, "100": 75, "500": 325, "1000": 599}, "ai_text": {"10": 10, "100": 29, "500": 129, "1000": 229}}'
# Tariffs screen: posts per day -> Stars and included watermarks per channel per 30 days;
# discounts are "from N channels -> %" and "days -> %"
# POSTING_PLANS='{"1": {"stars": 75, "wm_photo": 30, "wm_video": 6}, "15": {"stars": 124, "wm_photo": 450, "wm_video": 75}, "50": {"stars": 199, "wm_photo": 1500, "wm_video": 250}, "150": {"stars": 349, "wm_photo": 4500, "wm_video": 750}, "500": {"stars": 499, "wm_photo": 15000, "wm_video": 2500}}'
# CHANNEL_DISCOUNTS='{"3": 2, "5": 5, "10": 10, "20": 15, "30": 20, "50": 25, "100": 30}'
# TERM_DISCOUNTS='{"30": 0, "90": 10, "180": 15, "365": 20}'
# Stars pack sizes from @PremiumBot: checkout offers extra days so the total matches the nearest pack
# STARS_PACKS='[50, 75, 100, 150, 250, 350, 500, 750, 1000, 1500, 2500, 5000, 10000, 25000, 50000]'
TRIAL_POSTS=100
# TRIAL_QUOTAS='{"wm_photo": 15, "wm_video": 15, "ai_text": 15}'
# Posts per day on the free plan; 0 hides the free plan
FREE_POSTS_PER_DAY=10
CALC_MAX_CHANNELS=100
# Links next to the consent checkbox on the payment screen. Empty TERMS_URL = built-in page with the /terms text
TERMS_URL=
PRIVACY_URL=https://telegram.org/privacy-tpa

# ---- Media / worker -----------------------------------------------------------
FFMPEG_BIN=ffmpeg
# WATERMARK_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
WATERMARK_CONCURRENCY=2
WORKER_INTERVAL=10
MISSED_GRACE_HOURS=2
